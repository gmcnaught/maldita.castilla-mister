# Makefile.joy_play — standalone armhf cross-build of tools/joy_play.c
# (endless scripted-play driver, scripts/fpsdip/). Same shape as
# Makefile.audio_ring_probe: no gmloader-next dependency.
# Build (from this repo root, reusing the gmloader armhf image):
#   docker run --rm -v "$PWD:/src" -w /src gmloader-armhf-build:bullseye \
#       make -f tools/Makefile.joy_play
# Host-native build (for a compile check only — it needs /dev/mem to run):
#   make -f tools/Makefile.joy_play ARCH=native
# Output: tools/joy_play.armhf

ARCH ?= arm-linux-gnueabihf

ifeq ($(ARCH),native)
CC  := cc
OUT := tools/joy_play.native
else
CC  := $(ARCH)-gcc
OUT := tools/joy_play.armhf
endif

# gnu11, not c11: clock_gettime/CLOCK_MONOTONIC and mmap sit behind glibc's
# __STRICT_ANSI__ gate under -std=c11 (same reason as Makefile.fabric_probe).
CFLAGS ?= -O2 -std=gnu11 -Wall -Wextra
ifeq ($(ARCH),arm-linux-gnueabihf)
CFLAGS += -mtune=cortex-a9
endif

SRC := tools/joy_play.c

.PHONY: all clean
all: $(OUT)

$(OUT): $(SRC)
	$(CC) $(CFLAGS) -o $@ $(SRC)

clean:
	rm -f tools/joy_play.armhf tools/joy_play.native
