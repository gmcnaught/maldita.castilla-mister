# Makefile.fps_probe — standalone armhf cross-build of tools/fps_probe.c
# (displayed-frame-rate probe, scripts/fpsdip/). Same shape as
# Makefile.audio_ring_probe: /dev/mem reads only, no mfgpu dependency.
# Build (from this repo root, reusing the gmloader armhf image):
#   docker run --rm -v "$PWD:/src" -w /src gmloader-armhf-build:bullseye \
#       make -f tools/Makefile.fps_probe
# Host-native build (for a compile check only — it needs /dev/mem to run):
#   make -f tools/Makefile.fps_probe ARCH=native
# Output: tools/fps_probe.armhf

ARCH ?= arm-linux-gnueabihf

ifeq ($(ARCH),native)
CC  := cc
OUT := tools/fps_probe.native
else
CC  := $(ARCH)-gcc
OUT := tools/fps_probe.armhf
endif

# gnu11, not c11: clock_gettime/CLOCK_MONOTONIC and mmap sit behind glibc's
# __STRICT_ANSI__ gate under -std=c11 (same reason as Makefile.fabric_probe).
CFLAGS ?= -O2 -std=gnu11 -Wall -Wextra
ifeq ($(ARCH),arm-linux-gnueabihf)
CFLAGS += -mtune=cortex-a9
endif

SRC := tools/fps_probe.c

.PHONY: all clean
all: $(OUT)

$(OUT): $(SRC)
	$(CC) $(CFLAGS) -o $@ $(SRC)

clean:
	rm -f tools/fps_probe.armhf tools/fps_probe.native
